{
	"name": "styleguidefyi",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": { "node": ">=24 <25" },
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"deploy:preview": "astro build && wrangler deploy --config wrangler.preview.jsonc",
		"typecheck": "astro check",
		"test": "vitest run",
		"capture:mirrors": "node scripts/capture-mirrors.mjs",
		"verify:site": "node scripts/verify-site.mjs"
	},
	"dependencies": {
		"astro": "^6.0.1",
		"just-bash": "3.4.2"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.7",
		"@types/sanitize-html": "^2.16.1",
		"cheerio": "^1.2.0",
		"github-slugger": "^2.0.0",
		"marked": "^18.0.13",
		"sanitize-html": "^2.17.7",
		"vitest": "^4.1.11",
		"wrangler": "^4.80.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
