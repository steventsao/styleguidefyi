{
	"name": "styleguidefyi",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": { "node": ">=24 <25" },
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm plugin:build && astro build",
		"preview": "astro preview",
		"deploy": "astro build && wrangler deploy",
		"deploy:preview": "astro build && wrangler deploy --config wrangler.preview.jsonc",
		"typecheck": "pnpm plugin:build && astro check",
		"test": "pnpm plugin:build && vitest run",
		"plugin:build": "node scripts/build-plugin-app.mjs",
		"plugin:dev": "pnpm plugin:build && wrangler dev --config wrangler.plugin.preview.jsonc",
		"plugin:verify": "node scripts/verify-plugin.mjs",
		"plugin:dry-run": "pnpm plugin:build && wrangler deploy --dry-run --config wrangler.plugin.preview.jsonc",
		"plugin:deploy:preview": "pnpm plugin:build && wrangler deploy --config wrangler.plugin.preview.jsonc",
		"plugin:deploy": "pnpm plugin:build && wrangler deploy --config wrangler.plugin.jsonc",
		"capture:mirrors": "node scripts/capture-mirrors.mjs",
		"verify:site": "node scripts/verify-site.mjs"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"@modelcontextprotocol/ext-apps": "1.7.5",
		"@modelcontextprotocol/sdk": "1.31.0",
		"@openai/mcp-extensions": "0.1.0",
		"astro": "^6.0.1",
		"just-bash": "3.4.2",
		"posthog-js": "^1.434.17",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.7",
		"@types/sanitize-html": "^2.16.1",
		"cheerio": "^1.2.0",
		"esbuild": "0.28.2",
		"github-slugger": "^2.0.0",
		"marked": "^18.0.13",
		"sanitize-html": "^2.17.7",
		"vitest": "^4.1.11",
		"wrangler": "^4.80.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
