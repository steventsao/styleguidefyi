---
/**
 * Loads the analytics client on every page.
 *
 * A production build stops when the key is missing, so a deploy cannot quietly ship
 * a page that records nothing. Development and tests run without a key.
 */
if (import.meta.env.PROD && !import.meta.env.PUBLIC_POSTHOG_KEY) {
	throw new Error("PUBLIC_POSTHOG_KEY is missing. Copy .env.example to .env before a production build.");
}
---

<script>
	import { initAnalytics } from "../scripts/analytics";

	initAnalytics();
</script>
