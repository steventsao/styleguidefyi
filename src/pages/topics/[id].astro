---
import Base from "../../layouts/Base.astro";
import RuleBody from "../../components/RuleBody.astro";
import { blogPath, publishedPosts } from "../../lib/blog";
import { styleguide, type Section } from "../../data/styleguide";
import { topics } from "../../data/topics";
import { metaDescription, plainText, rulePath, topicPath } from "../../lib/rule-pages";

export function getStaticPaths() {
	return styleguide.sections.map((section, index) => {
		if (!topics[section.id]) throw new Error(`No topic copy for section: ${section.id}`);
		return { params: { id: section.id }, props: { section, sectionNumber: index + 1 } };
	});
}

interface Props { section: Section; sectionNumber: number; }
const { section, sectionNumber } = Astro.props;
const topic = topics[section.id];
const path = topicPath(section);
const canonical = new URL(path, Astro.site).href;
const description = metaDescription(topic.intro);
const ruleIds = new Set(section.rules.map((rule) => rule.id));
const articles = (await publishedPosts()).filter((post) => post.data.relatedRules.some((id) => ruleIds.has(id)));
const otherSections = styleguide.sections.filter((candidate) => candidate.id !== section.id);
const installCommand = `curl -s ${styleguide.url}${path}.md >> AGENTS.md`;

function inlineCode(text: string): string {
	return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/`([^`]+)`/g, "<code>$1</code>");
}

const schema = [
	{
		"@type": "CollectionPage",
		"@id": `${canonical}#topic`,
		url: canonical,
		name: topic.heading,
		description,
		dateModified: styleguide.updated,
		isPartOf: { "@id": `${styleguide.url}/#guide` },
		mainEntity: {
			"@type": "ItemList",
			numberOfItems: section.rules.length,
			itemListElement: section.rules.map((rule, index) => ({ "@type": "ListItem", position: index + 1, name: plainText(rule.title), url: new URL(rulePath(rule), Astro.site).href })),
		},
	},
	{
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Home", item: "https://styleguide.fyi/" },
			{ "@type": "ListItem", position: 2, name: "Rules", item: "https://styleguide.fyi/rules" },
			{ "@type": "ListItem", position: 3, name: section.title, item: canonical },
		],
	},
];
---

<Base title={`${topic.heading}: ${section.rules.length} rules with examples | styleguide.fyi`} description={description} canonicalPath={path} markdownUrl={`${path}.md`} structuredData={schema}>
	<div class="topic-page">
		<nav class="topic-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/rules">Rules</a></nav>
		<header>
			<p class="topic-eyebrow">Section {sectionNumber} · {section.rules.length} rules · updated {styleguide.updated}</p>
			<h1>{topic.heading}</h1>
			<p class="topic-intro" set:html={inlineCode(topic.intro)} />
			<nav class="topic-toc" aria-label="Rules in this section"><ol>{section.rules.map((rule) => <li><a href={`#${rule.id}`} set:html={inlineCode(rule.title)} /></li>)}</ol></nav>
		</header>
		{section.rules.map((rule, ruleIndex) => (
			<article class="topic-rule" id={rule.id}>
				<h2><span>{sectionNumber}.{ruleIndex + 1}</span><a href={rulePath(rule)} set:html={inlineCode(rule.title)} /></h2>
				<RuleBody rule={rule} />
				<p class="topic-rule-link"><a href={rulePath(rule)}>Reviewer assessments and Markdown for this rule</a></p>
			</article>
		))}
		<section class="topic-section" aria-labelledby="install-title">
			<h2 id="install-title">Give these rules to your coding agent</h2>
			<p>This section is also one Markdown file. Append it to the instruction file your agent reads, or see <a href="/agents">how to choose rules for an agent</a>.</p>
			<pre><code>{installCommand}</code></pre>
		</section>
		{articles.length > 0 && (
			<section class="topic-section" aria-labelledby="articles-title">
				<h2 id="articles-title">Articles on this topic</h2>
				<ul>{articles.map((post) => <li><a href={blogPath(post)}>{post.data.title}</a></li>)}</ul>
			</section>
		)}
		<section class="topic-section" aria-labelledby="more-title">
			<h2 id="more-title">Other sections of the guide</h2>
			<ul class="topic-others">{otherSections.map((other) => <li><a href={topicPath(other)}>{other.title}</a> <span>{other.rules.length} rules</span></li>)}</ul>
		</section>
	</div>
</Base>

<style is:global>
	.topic-page { max-width: 760px; margin: 0 auto; padding: 32px 24px 0; }
	.topic-breadcrumbs { display: flex; gap: 12px; color: var(--text-secondary); font-size: 0.875rem; }
	.topic-eyebrow { margin: 40px 0 12px; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--accent); }
	.topic-page h1 { margin: 0 0 20px; font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
	.topic-intro { margin: 0 0 24px; max-width: 64ch; font-size: 1.125rem; color: var(--text-secondary); }
	.topic-toc ol { margin: 0; padding-left: 24px; color: var(--text-secondary); }
	.topic-toc li { margin: 6px 0; }
	.topic-rule { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border); }
	.topic-rule h2 { display: flex; gap: 12px; align-items: baseline; margin: 0 0 12px; font-size: 1.375rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.015em; }
	.topic-rule h2 span { flex: none; font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 400; color: var(--muted); }
	.topic-rule h2 a { text-decoration: none; }
	.topic-rule-link { margin: 16px 0 0; font-size: 0.875rem; color: var(--text-secondary); }
	.topic-section { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--border); }
	.topic-section h2 { margin: 0 0 12px; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.02em; }
	.topic-section p { margin: 0 0 16px; max-width: 64ch; color: var(--text-secondary); }
	.topic-section pre { margin: 0; padding: 14px 16px; font-size: 0.8125rem; line-height: 1.6; border: 1px solid var(--border); border-radius: var(--radius); background: var(--code-bg); overflow-x: auto; }
	.topic-section ul { margin: 0; padding-left: 20px; }
	.topic-section li { margin: 8px 0; }
	.topic-others span { font-size: 0.8125rem; color: var(--muted); }
	@media (max-width: 560px) { .topic-page { padding: 24px 16px 0; } }
</style>
