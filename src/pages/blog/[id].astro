---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Newsletter from "../../components/Newsletter.astro";
import { blogPath, formatDate, publishedPosts, readingMinutes } from "../../lib/blog";
import { styleguide } from "../../data/styleguide";
export async function getStaticPaths() { return (await publishedPosts()).map((post) => ({ params: { id: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<"blog">; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const rules = styleguide.sections.flatMap((section) => section.rules);
const relatedRules = post.data.relatedRules.map((id) => {
	const rule = rules.find((candidate) => candidate.id === id);
	if (!rule) throw new Error(`Unknown related rule: ${id} in ${post.id}`);
	return rule;
});
const related = (await publishedPosts()).filter((candidate) => candidate.id !== post.id).slice(0, 2);
const canonical = new URL(blogPath(post), Astro.site).href;
const published = post.data.published.toISOString();
const modified = (post.data.updated ?? post.data.published).toISOString();
const schema = [
	{ "@type": "BlogPosting", "@id": `${canonical}#article`, headline: post.data.title, description: post.data.description, url: canonical, mainEntityOfPage: canonical, datePublished: published, dateModified: modified, author: { "@type": "Organization", name: "styleguide.fyi", url: "https://styleguide.fyi/about" }, publisher: { "@id": "https://styleguide.fyi/#publisher" }, isPartOf: { "@id": "https://styleguide.fyi/blog#blog" }, articleSection: post.data.category, inLanguage: "en", isAccessibleForFree: true },
	{ "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://styleguide.fyi/" }, { "@type": "ListItem", position: 2, name: "Blog", item: "https://styleguide.fyi/blog" }, { "@type": "ListItem", position: 3, name: post.data.title, item: canonical }] },
];
---

<Base title={`${post.data.title} — styleguide.fyi`} description={post.data.description} canonicalPath={blogPath(post)} markdownUrl={null} article={{ published, modified }} structuredData={schema}>
	<div class="article-shell">
		<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">Blog</a></nav>
		<article>
			<header class="article-header"><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><p class="article-meta">By <a href="/about">styleguide.fyi</a><span>Published <time datetime={published}>{formatDate(post.data.published)}</time></span>{post.data.updated && <span>Updated <time datetime={modified}>{formatDate(post.data.updated)}</time></span>}<span>{readingMinutes(post.body)} min read</span><span>{post.data.category}</span></p></header>
			<div class="article-layout">
				<aside><nav aria-label="In this article"><p>In this article</p><ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>
				<div class="article-body"><Content /><section class="related-rules" aria-labelledby="related-rules-title"><h2 id="related-rules-title">The rules behind this article</h2><ul>{relatedRules.map((rule) => <li><a href={`/#${rule.id}`}>{rule.title}</a></li>)}</ul></section></div>
			</div>
		</article>
		<section class="related-posts" aria-labelledby="continue-title"><h2 id="continue-title">Keep reading</h2>{related.map((item) => <a href={blogPath(item)}>{item.data.title}</a>)}</section>
		<Newsletter />
	</div>
</Base>

<style is:global>
	.article-shell { max-width: var(--page-width); margin: 0 auto; padding: 32px 24px 0; }
	.breadcrumbs { display: flex; gap: 12px; color: var(--text-secondary); font-size: 0.875rem; }
	.article-header { max-width: 820px; padding: 32px 0 40px; }
	.article-header h1 { margin: 0 0 24px; max-width: 24ch; font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; text-wrap: balance; }
	.article-description { max-width: 64ch; font-size: 1.125rem; color: var(--text-secondary); }
	.article-meta { display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--text-secondary); font-size: 0.875rem; }
	.article-layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 48px; border-top: 1px solid var(--border); padding-top: 32px; }
	.article-layout aside nav { position: sticky; top: 88px; }
	.article-layout aside p { margin: 0 0 12px; font-weight: 500; font-size: 0.875rem; }
	.article-layout aside ol { list-style: none; padding: 0; margin: 0; }
	.article-layout aside li { margin-bottom: 12px; font-size: 0.875rem; line-height: 1.5; color: var(--text-secondary); }
	.article-body { max-width: 70ch; font-size: 1.0625rem; line-height: 1.8; min-width: 0; overflow-wrap: anywhere; }
	.article-body > p:first-child { margin-top: 0; }
	.article-body h2 { margin: 40px 0 16px; line-height: 1.25; font-size: 1.625rem; font-weight: 600; letter-spacing: -0.02em; text-wrap: balance; }
	.article-body p { margin: 0 0 20px; }
	.article-body li { margin: 8px 0; }
	.article-body pre { overflow-x: auto; padding: 20px; font-size: 0.8125rem; line-height: 1.7; border: 1px solid var(--border); border-radius: var(--radius); }
	.article-body .related-rules { margin-top: 40px; padding-top: 8px; border-top: 1px solid var(--border); }
	.related-posts { margin: 64px 0 40px; border-top: 1px solid var(--border); padding-top: 24px; }
	.related-posts h2 { margin: 0 0 16px; font-size: 1.25rem; font-weight: 500; }
	.related-posts > a { display: block; margin: 12px 0; }
	@media (max-width: 760px) { .article-shell { padding: 24px 20px 0; } .article-layout { grid-template-columns: 1fr; gap: 32px; } .article-layout aside nav { position: static; } .article-layout aside ol { columns: 2; column-gap: 24px; } .article-layout aside li { break-inside: avoid; } }
	@media (max-width: 440px) { .article-layout aside ol { columns: 1; } }
</style>
