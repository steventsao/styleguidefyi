---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — styleguide.fyi" description="This page does not exist.">
	<section class="not-found">
		<p class="code">404</p>
		<h1>There is no page here.</h1>
		<p><a href="/">Go to the style guide</a></p>
	</section>
</Base>

<style>
	.not-found {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 96px 16px;
	}

	.code {
		margin: 0;
		font-family: var(--font-mono);
		color: var(--accent);
	}

	h1 {
		margin: 8px 0 16px;
		font-size: 2rem;
		letter-spacing: -0.02em;
	}
</style>
