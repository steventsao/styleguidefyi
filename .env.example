# PostHog project "styleguidefyi" (project 635091).
# The token is public and write-only: it ships in the HTML of every page. It is still kept
# out of this repository, so the live project is not the first result for a token search.
# CI reads it from the repository variable PUBLIC_POSTHOG_KEY. For a local build, copy this
# file to .env and paste the token from the PostHog project settings.
# A build without it succeeds and simply records nothing.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
