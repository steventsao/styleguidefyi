{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "styleguidefyi",
	"compatibility_date": "2026-02-24",
	"main": "src/newsletter/worker.ts",
	// Reading pages remain static. Only newsletter requests invoke the Worker.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		// Canonical URLs, the sitemap and internal links have no trailing slash. Serve that form directly;
		// the default redirects it to the slash form, which makes every canonical URL a redirect.
		"html_handling": "drop-trailing-slash",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
	},
	"d1_databases": [{ "binding": "NEWSLETTER_DB", "database_name": "styleguidefyi-newsletter", "database_id": "0ccf9cad-afb1-4213-89da-c38a1d9057f3", "migrations_dir": "migrations" }],
	"ratelimits": [{ "name": "NEWSLETTER_LIMITER", "namespace_id": "2026101701", "simple": { "limit": 10, "period": 60 } }],
	"routes": [
		{ "pattern": "styleguide.fyi", "custom_domain": true },
		{ "pattern": "www.styleguide.fyi", "custom_domain": true },
	],
}
